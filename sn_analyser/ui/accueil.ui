<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AccueilWidget</class>
 <widget class="QWidget" name="AccueilWidget">
  <property name="windowTitle">
   <string>SN Analyser</string>
  </property>
  <layout class="QVBoxLayout" name="outerLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QScrollArea" name="scrollArea">
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <property name="frameShape">
      <enum>QFrame::NoFrame</enum>
     </property>
     <widget class="QWidget" name="scrollAreaWidgetContents">
      <layout class="QVBoxLayout" name="mainLayout">

   <item>
    <widget class="QLabel" name="lblTitre">
     <property name="text">
      <string>&lt;h2&gt;SN ANALYSER&lt;/h2&gt;</string>
     </property>
    </widget>
   </item>

   <!-- Zone d'étude -->
   <item>
    <widget class="QGroupBox" name="gbZoneEtude">
     <property name="title">
      <string>Zone d'étude</string>
     </property>
     <layout class="QVBoxLayout" name="zoneEtudeLayout">
      <item>
       <widget class="QLabel" name="lblNiveau">
        <property name="text">
         <string>Niveau :</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="cbNiveau">
        <property name="toolTip">
         <string>Choisir le niveau administratif (région, département ou commune)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lblNom">
        <property name="text">
         <string>Nom :</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="cbNom">
        <property name="toolTip">
         <string>Choisir la région, le département ou la commune à analyser</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Période -->
   <item>
    <widget class="QGroupBox" name="gbPeriode">
     <property name="title">
      <string>Période</string>
     </property>
     <layout class="QHBoxLayout" name="periodeLayout">
      <item>
       <widget class="QLabel" name="lblDate">
        <property name="text">
         <string>Date :</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QSpinBox" name="spinAnneeFin">
        <property name="toolTip">
         <string>Année analysée (1984 à 2026)</string>
        </property>
        <property name="minimum">
         <number>1984</number>
        </property>
        <property name="maximum">
         <number>2026</number>
        </property>
        <property name="value">
         <number>2026</number>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="chkHauteResolution">
        <property name="text">
         <string>🛰️ Haute résolution (Sentinel-2 10 m)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="toolTip">
         <string>A partir de 2017 : images Sentinel-2 a 10 m (20 m pour les grandes zones) au lieu de Landsat 30 m. Avant 2017 ou pour les tres grandes zones, Landsat est utilise automatiquement.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Indices -->
